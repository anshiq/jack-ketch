[Unit]
Description=jack-ketch daemon (1 per OS user, hosts all projects)
Documentation=https://github.com/anshiq/jack-ketch
Requires=jackketchd.socket
After=jackketchd.socket

[Service]
# KillMode=process is CRITICAL: systemd must not kill shims when jackketchd
# restarts. Shims are setsid'd into their own sessions; the new daemon
# re-attaches via shim.sock (§2.3, §R2).
Type=notify
KillMode=process
Delegate=yes
Restart=on-failure
RestartSec=1s
ExecStart=%h/.local/bin/jackketchd --foreground
NotifyAccess=main

[Install]
WantedBy=default.target
